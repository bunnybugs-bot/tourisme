# Copiez ce fichier en « .env » puis adaptez-le. Ne le publiez jamais (il contient un mot de passe).
# postgresql://UTILISATEUR:MOT_DE_PASSE@HOTE:PORT/NOM_BASE     (caractères spéciaux du mot de passe : @ -> %40, # -> %23, / -> %2F)
DATABASE_URL=postgresql://postgres:MOT_DE_PASSE@localhost:5432/tourisme_thies

# Mettre une valeur longue et aléatoire en production : python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=changez-moi
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Windows uniquement, si la détection automatique de GDAL échoue (voir README.md, section « GDAL sous Windows ») :
# GDAL_LIBRARY_PATH=C:\Program Files\QGIS 3.34.0\bin\gdal312.dll
# GEOS_LIBRARY_PATH=C:\Program Files\QGIS 3.34.0\bin\geos_c.dll
